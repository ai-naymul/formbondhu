    },
    {
      "office_en": "Accounts Section",
      "office_bn": "হিসাব শাখা",
      "task_en": "Pay the duplicate ID fee and collect the slip.",
      "task_bn": "ডুপ্লিকেট আইডির ফি জমা দিয়ে রসিদ নিন।"
    },
    {
      "office_en": "Office of the Registrar",
      "office_bn": "রেজিস্ট্রার অফিস",
      "task_en": "Submit the form with the GD copy and fee slip.",
      "task_bn": "জিডির কপি ও ফি রসিদসহ ফরম জমা দিন।"
    }
  ],
  "kind": "form",
