  "photo_required": true,
  "rules": [
    {
      "id": "ID-1",
      "type": "required",
      "field": "student_name",
      "en": "Student name is missing.",
      "bn": "শিক্ষার্থীর নাম লেখা হয়নি।"
    },
    {
      "id": "ID-2",
      "type": "pattern",
      "field": "student_id",
      "pattern": "^[A-Z]\\d{6}$",
      "en": "Student ID must be one capital letter followed by 6 digits, e.g. L201033.",
      "bn": "আইডি নম্বর সঠিক ফরম্যাটে নেই। একটি ইংরেজি বড় হাতের অক্ষর ও ৬টি সংখ্যা লিখুন, যেমন L201033।"
    },
    {
      "id": "ID-3",
      "type": "pattern",
      "field": "session",
      "pattern": "^\\d{4}-\\d{2}$",
      "en": "Session must be written like 2020-21.",
      "bn": "সেশন 2020-21 এর মতো করে লিখুন।"
    },
    {
      "id": "ID-4",
      "type": "required",
      "field": "gd_number",
      "en": "GD number is missing; file a General Diary at the police station for a lost card.",
      "bn": "জিডি নম্বর লেখা হয়নি। আইডি কার্ড হারালে থানায় জিডি করে নম্বরটি লিখতে হবে।"
    },
    {
      "id": "ID-5",
      "type": "date",
      "field": "date",
      "en": "Date must be written as DD/MM/YYYY, e.g. 24/10/2026.",
      "bn": "তারিখ দিন/মাস/বছর (DD/MM/YYYY) ফরম্যাটে লিখতে হবে, যেমন 24/10/2026।"
    },
    {
      "id": "ID-6",
      "type": "signature",
      "signature": "student",
      "en": "Student's signature is missing.",
      "bn": "শিক্ষার্থীর স্বাক্ষর নেই।"
    },
    {
      "id": "ID-7",
      "type": "photo",
      "en": "Passport-size photo is not attached.",
      "bn": "পাসপোর্ট সাইজের ছবি লাগানো হয়নি।"
    }
  ],
  "attachments": [
    {
      "en": "Copy of the police General Diary (GD)",
      "bn": "থানায় করা জিডির কপি"
    },
    {
      "en": "Duplicate ID fee payment slip (sample fee: Tk 200)",
